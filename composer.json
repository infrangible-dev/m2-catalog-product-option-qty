{
    "name": "infrangible/m2-catalog-product-option-qty",
    "description": "Lets shoppers choose a quantity for a custom option, for example several pieces of an add-on. Option prices are multiplied by the chosen quantity.",
    "type": "magento2-module",
    "version": "1.12.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Pricing",
        "quantity for custom options",
        "option quantity field",
        "custom option price times quantity"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-qty",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-option": "~1.3.0",
        "infrangible/m2-catalog-product-option-wrapper": "~1.2.0",
        "infrangible/m2-select2": "~1.0.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionQty\\": "src"
        }
    }
}
